# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

__mocks__/
# Ignore test files


# Ignore test snapshots (used with Jest)
*.snap

# Ignore coverage reports
coverage/
.nyc_output/

# Ignore test result outputs (Vitest/Jest, etc.)
test-results/
test-results.json
*.log

# Ignore Playwright/Cypress test artifacts (optional if you use them)
playwright-report/
cypress/videos/
cypress/screenshots/
