{
  "name": "candidate-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,css}\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:integration": "vitest --config vitest.integration.config.ts",
    "test:integration:ui": "vitest --config vitest.integration.config.ts --ui",
    "test:integration:run": "firebase emulators:exec --config firebase.test.json \"pnpm vitest run --config vitest.integration.config.ts\"",
    "test:all": "vitest run && vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "emulators": "firebase emulators:start",
    "emulators:test": "firebase emulators:start --config firebase.test.json",
    "emulators:export": "firebase emulators:export ./emulator-data",
    "emulators:import": "firebase emulators:start --import=./emulator-data",
    "reset-db": "tsx scripts/reset-database.ts",
    "reset-db:confirm": "echo 'Are you sure? This will delete ALL data!' && read -p 'Type YES to continue: ' confirm && [ \"$confirm\" = \"YES\" ] && npm run reset-db",
    "prepare": "husky"
  },
  "dependencies": {
    "@google/genai": "^1.10.0",
    "@google/generative-ai": "^0.24.1",
    "@headlessui/react": "^2.2.4",
    "@react-email/components": "^1.0.12",
    "@tanstack/react-query": "^5.90.10",
    "@types/sanitize-html": "^2.16.1",
    "@upstash/ratelimit": "^2.0.7",
    "@upstash/redis": "^1.35.7",
    "clsx": "^2.1.1",
    "csrf": "^3.1.0",
    "date-fns": "^4.1.0",
    "email-validator-dns-provider-rules": "^2.0.0",
    "firebase": "^11.8.1",
    "firebase-admin": "^13.4.0",
    "glob": "^13.0.0",
    "google-auth-library": "^10.1.0",
    "googleapis": "^150.0.1",
    "lucide-react": "^0.525.0",
    "next": "15.5.29",
    "next-themes": "^0.4.6",
    "pretty-quick": "^4.2.2",
    "react": "18.3.1",
    "react-big-calendar": "^1.18.0",
    "react-dom": "18.3.1",
    "react-icons": "^5.5.0",
    "recharts": "^2.15.3",
    "resend": "^6.10.0",
    "sanitize-html": "^2.17.2",
    "tailwind-merge": "^3.4.0",
    "text-encoding": "^0.7.0",
    "uuid": "^13.0.0",
    "whatwg-fetch": "^3.6.20",
    "xlsx": "^0.18.5",
    "zod": "^4.1.13"
  },
  "pnpm": {
    "overrides": {
      "react": "18.3.1",
      "react-dom": "18.3.1"
    }
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@eslint/eslintrc": "^3",
    "@eslint/js": "^9.39.1",
    "@next/eslint-plugin-next": "^16.0.4",
    "@playwright/test": "^1.56.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20.19.2",
    "@types/node-fetch": "^2.6.12",
    "@types/react": "^18",
    "@types/react-big-calendar": "^1.16.1",
    "@types/react-dom": "^18",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/ui": "^2.1.8",
    "dotenv": "^17.2.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.0.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "lint-staged": "^15.5.2",
    "postcss": "^8",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.20.3",
    "typescript": "^5",
    "vitest": "^2.1.8"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json}": [
      "prettier --write"
    ]
  }
}
