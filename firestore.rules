rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: true when the caller holds the admin custom claim
    // (set by /api/admin-auth/verify-otp via Firebase Admin createCustomToken)
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Candidates Collection Rules
    match /candidates/{candidateId} {
      // Allow any visitor to create a new candidate document (open application process).
      allow create: if true;

      // Only verified admins (custom-claim admin=true) can read/update/delete.
      allow read, update, delete: if isAdmin();
    }

    // Jobs Collection Rules
    match /jobs/{jobId} {
      // Anyone can read public job listings.
      allow read: if true;

      // Only verified admins can manage job listings.
      allow create, update, delete: if isAdmin();
    }
  }
}