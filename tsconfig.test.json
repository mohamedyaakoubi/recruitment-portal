{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "types": [
            "vitest/globals"
        ],
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "strict": false
    },
    "include": [
        "**/__tests__/**/*",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "vitest.d.ts"
    ]
}